# Local development only. Copy this file to .env and set your local values.
# Never commit .env.
DB_PASSWORD=change_me

# Mail (optional locally): the defaults send to Mailpit from compose.yaml
# (SMTP localhost:1025, inbox at http://localhost:8025) and put
# http://localhost:3000 in verification links.
# MAIL_HOST=localhost
# MAIL_PORT=1025
# MAIL_FROM=no-reply@workly.local
# APP_BASE_URL=http://localhost:3000

# --- Production (documentation only) ---------------------------------------
# Production runs with SPRING_PROFILES_ACTIVE=prod and takes its settings from
# real environment variables or a secret manager, never from a .env file.
# The app refuses to start when one of these is missing or insecure
# (ProductionSettingsCheck):
#
#   SPRING_PROFILES_ACTIVE=prod
#   DB_URL=jdbc:postgresql://<host>:5432/<database>
#   DB_USERNAME=<user>
#   DB_PASSWORD=<secret>
#   MAIL_HOST=<smtp host>              (authenticated SMTP with STARTTLS)
#   MAIL_PORT=587
#   MAIL_USERNAME=<smtp user>
#   MAIL_PASSWORD=<secret>
#   MAIL_FROM=no-reply@<your domain>   (SPF, DKIM and DMARC set up for it)
#   APP_BASE_URL=https://<public frontend origin>   (used in mailed links)
#
# The prod profile always sets Secure session and XSRF-TOKEN cookies (HTTPS
# only); overriding workly.session.cookie-secure to false stops the startup.
#
# Before deployment, also:
# - restrict the trusted proxies (server.tomcat.remoteip.internal-proxies);
#   Tomcat's default trusts localhost and all private networks;
# - have the reverse proxy append the real client address to X-Forwarded-For
#   and send X-Forwarded-Proto=https;
# - decide on HSTS at the reverse proxy.
#
# The frontend build needs BACKEND_URL (the /api rewrite) and SITE_URL.
